NODE_ENV=development
PORT=3000
MONGO_URI_WRITE=mongodb://localhost:27017/watch_db_write
MONGO_URI_READ=mongodb://localhost:27017/watch_db_read
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=super_secret_jwt_key_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_key_here
